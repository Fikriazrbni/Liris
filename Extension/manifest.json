{
  "manifest_version": 3,
  "name": "Liris Auto Bridge",
  "version": "0.3.0",
  "description": "Send playback metadata from YouTube and YouTube Music to the local Liris app.",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
